# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# =============================================================================
# Vagrantfile - COGSI CA2 / Part 1
# -----------------------------------------------------------------------------
# A single Ubuntu 24.04 VM that clones the group repository, builds the two
# CA1 applications and runs them as services:
#   - Bookstore (Spring Boot, Gradle)  -> guest port 8080
#   - Chat server (Gradle demo)        -> guest port 59001
#
# =============================================================================

Vagrant.require_version ">= 2.4.0", "< 3.0.0"

# -----------------------------------------------------------------------------
# Host-driven configuration
# -----------------------------------------------------------------------------
clone_repo     = ENV["CLONE_REPO"]     || "true"
build_apps     = ENV["BUILD_APPS"]     || "true"

repo_url     = ENV["REPO_URL"]     || "https://github.com/Af-Oliveira/COGSI-2026-2027.git"
repo_branch  = ENV["REPO_BRANCH"]  || "main"
github_token = ENV["GITHUB_TOKEN"] || ""

vm_memory = ENV["VM_MEMORY"] || "2048"
vm_cpus   = ENV["VM_CPUS"]   || "2"

# Guest-side constants shared by the provisioning scripts.
bookstore_port = 8080
chat_port      = 59001
repo_dir       = "/home/vagrant/COGSI-2026-2027"
h2_data_dir    = "/h2-data"

Vagrant.configure("2") do |config|

  # ===========================================================================
  # BOX
  # ---------------------------------------------------------------------------
  # Bento boxes are built by Progress Chef from public Packer templates
  # (github.com/chef/bento) and are the boxes recommended by the Vagrant
  # documentation. The version is pinned so that every team member and every
  # rebuild starts from exactly the same image.
  # ===========================================================================
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.vm.box_check_update = false

  config.vm.hostname = "cogsi-ca2-part1"

  # ===========================================================================
  # SYNCED FOLDERS
  # ---------------------------------------------------------------------------
  # The default project share is disabled: the scripts are uploaded by the
  # shell provisioner and the sources come from the Git clone, so nothing in
  # the VM depends on the host project folder.
  #
  # The only share is the folder dedicated to the H2 database files, which
  # keeps the data on the host across `vagrant reload` and `vagrant destroy`.
  # ===========================================================================
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "./h2-data", h2_data_dir

  # ===========================================================================
  # PROVIDERS
  # ===========================================================================
  config.vm.provider "virtualbox" do |vb|
    vb.name = "cogsi-ca2-part1"
    vb.memory = vm_memory
    vb.cpus = vm_cpus
    vb.gui = false
  end

  config.vm.provider "vmware_desktop" do |vmware|
    vmware.vmx["memsize"] = vm_memory
    vmware.vmx["numvcpus"] = vm_cpus
  end

  # ===========================================================================
  # PROVISIONING
  # ---------------------------------------------------------------------------
  # One named provisioner per step, so that each one can be re-run on its own
  # with `vagrant provision --provision-with <name>`. Every script is
  # idempotent and the optional steps are switched by the variables above.
  # ===========================================================================
  config.vm.provision "shell",
    name: "base_packages",
    path: "provisioning/base.sh"

  # Runs as the vagrant user so that the working copy is not owned by root.
  config.vm.provision "shell",
    name: "clone_repository",
    path: "provisioning/clone.sh",
    privileged: false,
    env: {
      "CLONE_REPO"   => clone_repo,
      "REPO_URL"     => repo_url,
      "REPO_BRANCH"  => repo_branch,
      "REPO_DIR"     => repo_dir,
      "GITHUB_TOKEN" => github_token
    }

  config.vm.provision "shell",
    name: "build_apps",
    path: "provisioning/build.sh",
    privileged: false,
    env: {
      "BUILD_APPS" => build_apps,
      "REPO_DIR"   => repo_dir
    }

  config.vm.provision "shell",
    name: "deploy_apps",
    path: "provisioning/deploy.sh",
    env: {
      "REPO_DIR"       => repo_dir,
      "H2_DATA_DIR"    => h2_data_dir,
      "BOOKSTORE_PORT" => bookstore_port.to_s,
      "CHAT_PORT"      => chat_port.to_s
    }

end
