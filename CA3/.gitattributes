# Files parsed inside the Linux guests must keep LF line endings, even when the
# repository is checked out on a Windows host with core.autocrlf enabled.
*.sh            text eol=lf
*.yml           text eol=lf
*.j2            text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
Vagrantfile     text eol=lf
*.png           binary
*.pp            text eol=lf
*.epp           text eol=lf
*.yaml          text eol=lf
# Scripts and configuration files copied by Puppet into the guests.
alternative/puppet/modules/*/files/*  text eol=lf
