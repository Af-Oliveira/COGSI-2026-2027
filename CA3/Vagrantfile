# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# =============================================================================
# Vagrantfile - COGSI CA3
# -----------------------------------------------------------------------------
# The CA2 Part 2 environment, provisioned with Ansible instead of shell scripts:
#
#   host browser --8080--> proxy (Nginx) --8080--> app (Spring Boot) --9092--> db (H2)
#
#   Machine  Hostname  Private address   Role
#   db       db        192.168.56.22     H2 database engine in server mode
#   app      app       192.168.56.21     Bookstore Spring Boot application
#   proxy    proxy     192.168.56.20     Nginx reverse proxy, the only entry point
#
# Ansible runs inside each guest (ansible_local provisioner): the Windows host
# cannot be an Ansible control node, and this way nothing has to be installed
# on it. Each machine applies site.yml to itself, limited to its own name.
#
# Directory structure:
#   .
#   ├── Vagrantfile
#   ├── ansible/          playbook, inventory, roles and variables (synced to /vagrant/ansible)
#   └── keys/             SSH key pairs generated per machine (not versioned, not synced)
#
# Host environment variables (all optional):
#   APP_MEMORY, APP_CPUS        resources of the app machine
#   PROXY_HOST_PORT             host port forwarded to the proxy (default 8080)
#
# Useful commands:
#   vagrant up                  db, app and proxy, in this order
#   vagrant provision app       apply the playbook to app again
#   vagrant ssh db
# =============================================================================

Vagrant.require_version ">= 2.4.0", "< 3.0.0"

# -----------------------------------------------------------------------------
# Host-driven configuration
# -----------------------------------------------------------------------------
app_memory = ENV["APP_MEMORY"] || "2048"
app_cpus   = ENV["APP_CPUS"]   || "2"

proxy_host_port = (ENV["PROXY_HOST_PORT"] || "8080").to_i

# -----------------------------------------------------------------------------
# Topology (unchanged from CA2 Part 2)
# -----------------------------------------------------------------------------
MACHINES = {
  "db"    => { ip: "192.168.56.22", memory: "768",      cpus: "1" },
  "app"   => { ip: "192.168.56.21", memory: app_memory, cpus: app_cpus },
  "proxy" => { ip: "192.168.56.20", memory: "512",      cpus: "1" }
}

# -----------------------------------------------------------------------------
# Custom SSH keys
# -----------------------------------------------------------------------------
# One ed25519 key pair per machine, generated on the host the first time the
# Vagrantfile is loaded. The public half is handed to Ansible, which makes it
# the only key accepted by the guest.
keys_dir = File.join(__dir__, "keys")
insecure_keys = Dir.glob(File.join(Dir.home, ".vagrant.d", "insecure_private_keys", "*"))

MACHINES.each_key do |name|
  private_key = File.join(keys_dir, "#{name}_ed25519")
  next if File.exist?(private_key)

  Dir.mkdir(keys_dir) unless Dir.exist?(keys_dir)
  generated = system("ssh-keygen", "-q", "-t", "ed25519", "-N", "",
                     "-C", "cogsi-ca3-#{name}", "-f", private_key)
  raise "ssh-keygen failed for '#{name}'. Is OpenSSH installed on the host?" unless generated
end

Vagrant.configure("2") do |config|

  # ===========================================================================
  # GLOBAL SETTINGS
  # ===========================================================================
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.vm.box_check_update = false

  # Only the Ansible project is shared with the guests, so the private keys in
  # ./keys never reach them. The VirtualBox share is world-writable by default,
  # and Ansible ignores an ansible.cfg in a world-writable directory.
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder "./ansible", "/vagrant/ansible",
    mount_options: ["dmode=755", "fmode=644"]

  # Vagrant must not generate its own replacement key: each machine receives
  # the key created above through the ssh_access role.
  config.ssh.insert_key = false

  MACHINES.each do |name, machine|
    config.vm.define name, primary: name == "app" do |node|

      node.vm.hostname = name
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = "cogsi-ca3-#{name}"
        vb.memory = machine[:memory]
        vb.cpus = machine[:cpus]
        vb.gui = false
      end

      node.vm.provider "vmware_desktop" do |vmware|
        vmware.vmx["memsize"] = machine[:memory]
        vmware.vmx["numvcpus"] = machine[:cpus]
      end

      # The custom key is tried first. The insecure key is only accepted on
      # the very first boot, until the ssh_access role removes it.
      private_key = File.join(keys_dir, "#{name}_ed25519")
      node.ssh.private_key_path = [private_key] + insecure_keys

      if name == "proxy"
        # The proxy is the only machine that publishes an application port.
        node.vm.network "forwarded_port",
          guest: 80, host: proxy_host_port,
          host_ip: "127.0.0.1", auto_correct: true
      end

      # -----------------------------------------------------------------------
      # Ansible, run inside the guest against the guest itself
      # -----------------------------------------------------------------------
      node.vm.provision "ansible_local" do |ansible|
        ansible.provisioning_path = "/vagrant/ansible"
        ansible.config_file       = "ansible.cfg"
        ansible.inventory_path    = "hosts.ini"
        ansible.playbook          = "site.yml"
        ansible.limit             = name
        ansible.compatibility_mode = "2.0"
        ansible.extra_vars = {
          ssh_public_key: File.read("#{private_key}.pub").strip
        }
      end
    end
  end

end
