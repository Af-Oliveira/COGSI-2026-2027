# CA4 Part 2 - environment of docker compose. Copy to .env and set the password:
#   cp .env.example .env
# .env is not versioned (it holds the database password).

# Images: Docker Hub namespace and tags
IMAGE_NAMESPACE=rmotafreitas
APP_VERSION=1.0.0
PROXY_VERSION=1.0.0
H2_VERSION=2.4.240

# db: credentials and storage
DB_NAME=bookstore
DB_USER=bookstore
# Required: compose refuses to start while it is empty.
DB_PASSWORD=
H2_PORT=9092
DB_JAVA_OPTS=-Xmx256m

# web: Spring application and database connectivity
WEB_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
WEB_JAVA_OPTS=-XX:MaxRAMPercentage=75

# proxy: externally exposed port and routing
PROXY_PUBLISHED_PORT=8080
PROXY_LISTEN_PORT=80
PROXY_UPSTREAM_HOST=web
PROXY_READ_TIMEOUT=60s
