# CA4 Part 2 - environment of docker compose. Copy to .env and set the password:
#   cp .env.example .env
# .env is not versioned (it holds the database password).

# Images: Docker Hub namespace and tags
IMAGE_NAMESPACE=rmotafreitas
H2_VERSION=2.4.240

# db: credentials and storage
DB_NAME=bookstore
DB_USER=bookstore
# Required: compose refuses to start while it is empty.
DB_PASSWORD=
H2_PORT=9092
DB_JAVA_OPTS=-Xmx256m

