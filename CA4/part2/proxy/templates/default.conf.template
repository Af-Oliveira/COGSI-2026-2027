# Rendered by the entrypoint of the nginx image (envsubst) at container start.

# Docker's embedded DNS server. With a variable in proxy_pass, Nginx resolves
# the upstream name at request time (cached for 10 s) instead of once at
# start, so it follows the web container if it is recreated with a new address.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen ${NGINX_PORT} default_server;
    server_name _;

    # Liveness of the proxy itself, used by its health check.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $upstream http://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_pass $upstream;

        # Pass the address the client used, port included, so that the links
        # generated by the application (HATEOAS) point back to the proxy.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    ${PROXY_READ_TIMEOUT};
    }
}
