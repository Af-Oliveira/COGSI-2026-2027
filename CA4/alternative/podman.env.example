# CA4 alternative - settings of the Podman environment (the same variables as
# CA4/part2/.env.example). Copy to podman.env; up.sh derives one environment
# file per service from it. The password is not here: up.sh asks for it and
# stores it as a Podman secret.
DB_NAME=bookstore
DB_USER=bookstore
H2_PORT=9092
DB_JAVA_OPTS=-Xmx256m

WEB_PORT=8080
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
WEB_JAVA_OPTS=-XX:MaxRAMPercentage=75

PROXY_PUBLISHED_PORT=8090
PROXY_LISTEN_PORT=80
PROXY_UPSTREAM_HOST=web
PROXY_READ_TIMEOUT=60s
